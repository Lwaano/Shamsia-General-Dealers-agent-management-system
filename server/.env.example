# PostgreSQL connection string used by the app at runtime, e.g. from Neon/Supabase/Railway:
# postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/shamsia"

# Direct (non-pooled) connection string, used only by Prisma Migrate.
# If your provider gives you a single URL with no separate pooled/direct variants
# (e.g. a plain local Postgres or most non-serverless hosts), just set this to the
# same value as DATABASE_URL. For Neon specifically, this is the pooled DATABASE_URL
# host with "-pooler" removed.
DIRECT_URL="postgresql://user:password@localhost:5432/shamsia"

# Secret used to sign JWTs - change this to a long random string
JWT_SECRET="change-this-to-a-long-random-string"

# Port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN="http://localhost:5173"
