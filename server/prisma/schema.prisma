generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  TELLER
}

enum ProviderType {
  MOBILE_MONEY
  BANK
}

enum AgentType {
  MOBILE_MONEY_AGENT
  BANKING_AGENT
}

enum FloatTxType {
  TOPUP
  DISTRIBUTION
  RETURN
  ADJUSTMENT
}

enum TransactionType {
  CASH_IN
  CASH_OUT
  AIRTIME
  BILL_PAYMENT
  DEPOSIT
  WITHDRAWAL
}

enum InventoryTxType {
  PURCHASE
  SALE
  ADJUSTMENT
}

enum ReconciliationStatus {
  OPEN
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  position     String? // job title shown alongside their name, e.g. "Branch Teller" - distinct from `role`, which only controls access
  email        String   @unique
  passwordHash String
  role         Role     @default(TELLER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Which branch this person is assigned to. Admins may be left branch-less (HQ,
  // sees everything); Managers/Tellers are scoped to their branch's own data.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  floatTransactions     FloatTransaction[]
  transactions          Transaction[]
  inventoryTransactions InventoryTransaction[]
  openedReconciliations Reconciliation[]       @relation("ReconciliationOpenedBy")
  closedReconciliations Reconciliation[]       @relation("ReconciliationClosedBy")
  auditLogs             AuditLog[]
}

// A physical Shamsia location - e.g. one of the ten Mazabuka branches or the Pemba
// branch. Each branch runs its own float and agent network; totals across branches
// are combined (summed) for the company-wide view rather than stored separately.
model Branch {
  id        String   @id @default(cuid())
  name      String // e.g. "Mazabuka Branch 3"
  town      String // e.g. "Mazabuka", "Pemba"
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users             User[]
  agents            Agent[]
  floatAccounts     FloatAccount[]
  transactions      Transaction[]
  floatTransactions FloatTransaction[]

  @@unique([name])
}

model Provider {
  id       String       @id @default(cuid())
  name     String
  code     String       @unique
  type     ProviderType
  isActive Boolean      @default(true)

  agents        Agent[]
  floatAccounts FloatAccount[]
}

model Agent {
  id             String    @id @default(cuid())
  name           String
  phoneNumber    String
  location       String?
  agentType      AgentType
  commissionRate Float     @default(0.01)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  floatAccounts FloatAccount[]
  transactions  Transaction[]
}

model FloatAccount {
  id          String   @id @default(cuid())
  balance     Float    @default(0)
  lowFloatAt  Float    @default(500)
  lastUpdated DateTime @default(now())

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  // Every float account - master or agent-owned - belongs to exactly one branch.
  // A provider therefore has one master account PER branch, not one company-wide.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // null agentId => this is the branch's own master account for the provider
  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  outgoingFloatTx FloatTransaction[] @relation("FromAccount")
  incomingFloatTx FloatTransaction[] @relation("ToAccount")
  reconciliations Reconciliation[]

  @@unique([providerId, agentId, branchId])
}

model FloatTransaction {
  id               String        @id @default(cuid())
  type             FloatTxType
  amount           Float
  fromAccountId    String?
  fromAccount      FloatAccount? @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccountId      String?
  toAccount        FloatAccount? @relation("ToAccount", fields: [toAccountId], references: [id])
  balanceAfterFrom Float?
  balanceAfterTo   Float?
  reference        String?
  note             String?
  createdAt        DateTime      @default(now())

  // Denormalized from the account(s) involved (they're always in the same branch)
  // so branch-level ledgers don't need a join through FloatAccount.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])
}

model Transaction {
  id               String          @id @default(cuid())
  type             TransactionType
  amount           Float
  commissionAmount Float           @default(0)
  floatImpact      Float
  balanceAfter     Float
  customerPhone    String?
  reference        String?
  createdAt        DateTime        @default(now())

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  // Denormalized from agent.branchId at creation time for branch-level reporting
  // without a join, and so it stays correct even if the agent is later reassigned.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])
}

// One open/close cycle for a single float account (a day, or a shift). Compares the
// system's own running balance against a physically verified count so a shortage —
// float or cash — shows up immediately instead of being buried until month-end.
model Reconciliation {
  id     String               @id @default(cuid())
  status ReconciliationStatus @default(OPEN)

  floatAccountId String
  floatAccount   FloatAccount @relation(fields: [floatAccountId], references: [id])

  openingFloatBalance Float // system float balance snapshot at open
  openingCash         Float    @default(0) // physical cash on hand at open (agent accounts only)
  openNote            String?
  openedAt            DateTime @default(now())
  openedById          String
  openedBy            User     @relation("ReconciliationOpenedBy", fields: [openedById], references: [id])

  closingFloatBalance Float? // system float balance snapshot at close
  closingFloatCounted Float? // float balance physically verified (e.g. against the provider's app)
  expectedClosingCash Float? // openingCash minus the net float impact of transactions during the window
  closingCashCounted  Float? // physical cash counted at close
  floatVariance       Float? // closingFloatCounted - closingFloatBalance
  cashVariance        Float? // closingCashCounted - expectedClosingCash
  closeNote           String?
  closedAt            DateTime?
  closedById          String?
  closedBy            User?     @relation("ReconciliationClosedBy", fields: [closedById], references: [id])

  @@index([floatAccountId, status])
}

model InventoryCategory {
  id    String          @id @default(cuid())
  name  String          @unique
  items InventoryItem[]
}

model InventoryItem {
  id             String   @id @default(cuid())
  name           String
  sku            String   @unique
  unitCost       Float
  unitPrice      Float
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(5)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  categoryId String?
  category   InventoryCategory? @relation(fields: [categoryId], references: [id])

  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  type          InventoryTxType
  quantity      Int
  unitPrice     Float
  totalAmount   Float
  quantityAfter Int
  note          String?
  createdAt     DateTime        @default(now())

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])
}

// A trail of who did what: every login attempt and every create/update across the
// app writes one row here, independent of the business record itself, so history
// survives even if the underlying record is later changed again.
model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "LOGIN_SUCCESS", "LOGIN_FAILED", "CREATE_TRANSACTION", "UPDATE_AGENT"
  entityType String? // e.g. "Transaction", "Agent", "User"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
